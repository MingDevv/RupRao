# =============================================================================
# RupRao Environment Configuration
# =============================================================================

# ล็อกอินด้วยเมลโรงเรียนผ่าน Firebase (แนะนำ) — ตั้ง PROJECT_ID แล้วจะใช้แทน PIN โรงเรียน
# ค่ามาจาก Firebase Console → Project settings → Your apps (ไม่ใช่ความลับ)
RUPRAO_FIREBASE_PROJECT_ID=
RUPRAO_FIREBASE_API_KEY=
RUPRAO_FIREBASE_AUTH_DOMAIN=
RUPRAO_FIREBASE_APP_ID=
RUPRAO_ALLOWED_EMAIL_DOMAIN=tesaban6.ac.th

# อีเมลแอดมิน คั่นด้วยจุลภาค — ถ้าตั้งไว้ แอดมินเข้าด้วยบัญชีเหล่านี้เท่านั้น (ไม่ใช้ Admin PIN)
RUPRAO_ADMIN_EMAILS=

# (ไม่บังคับ) กุญแจลงลายเซ็น session — เว้นว่างได้ ระบบจะสุ่มเก็บไว้ที่ data/.session_secret ให้เอง
RUPRAO_SESSION_SECRET=

# รหัสผ่านโรงเรียน (School PIN Gate) — ใช้เมื่อไม่ได้เปิดโหมดเมลโรงเรียน
# เว้นว่างไว้ หรือใส่ 0 เพื่อเปิดใช้งานโหมดสาธารณะโดยไม่ต้องใส่รหัสผ่าน
RUPRAO_PIN=

# รหัสผ่านผู้ดูแลระบบ (Admin PIN)
# ใช้สำหรับเข้าหน้า /admin เพื่อจัดการรูปภาพและคำขอลบ PDPA
RUPRAO_ADMIN_PIN=

# path ลับของหน้าแอดมิน (ไม่มีลิงก์ในหน้าเว็บ) เช่น teacher-x7k2 → เข้าที่ /teacher-x7k2
# เว้นว่าง = ใช้ /admin ตามเดิม
RUPRAO_ADMIN_PATH=

# พอร์ตสำหรับรันเซิร์ฟเวอร์ (ค่าเริ่มต้น 8000)
PORT=8000
